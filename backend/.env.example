# Server
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed origins (your Vercel frontend URL(s)), or * for any
FRONTEND_URL=https://your-frontend.vercel.app

# MongoDB
MONGO_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user@example.com
SMTP_APP_PASSWORD=your_smtp_app_password
CONTACT_RECEIVER=info@iten.tv

# Admin seed (used by seed/createAdmin.js — run once locally, not needed on Vercel)
ADMIN_SEED_NAME=Admin
ADMIN_SEED_EMAIL=admin@iten.tv
ADMIN_SEED_PASSWORD=ChangeMe123!
